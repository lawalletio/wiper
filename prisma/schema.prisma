generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ntag424 {
  cid        String  @id
  k0         String
  k1         String
  k2         String
  k3         String
  k4         String
  ctr        Int
  otc        String?
  designUuid String  @map("design_uuid") @db.Uuid

  @@index([otc])
  @@map("ntag424s")
}
